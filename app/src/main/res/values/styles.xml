<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 用系统 Material 主题打底（去标题栏），界面全部由 Compose 绘制 -->
    <style name="Theme.KeepRolling" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FAF8F3</item>
        <item name="android:statusBarColor">#FAF8F3</item>
        <item name="android:navigationBarColor">#FAF8F3</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 全屏沉浸：隐藏系统顶部状态栏 -->
        <item name="android:windowFullscreen">true</item>
        <!-- 让内容延伸到刘海/挖孔区域（API 27+ 生效，低版本自动忽略） -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
